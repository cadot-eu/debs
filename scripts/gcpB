#!/bin/bash

# gcpB - Git Commit Push for Bundles
# Parcourt tous les dossiers dans bundles/ et exécute un commit avec IA pour chacun

# Fonction d'affichage d'aide
show_usage() {
    printf "Usage: $0 [options]\n"
    printf "\n"
    printf "Options:\n"
    printf " -f|--force, Force push\n"
    printf " -p|--passtest, Pass tests\n"
    printf " -h|--help, Print help\n"
    printf " -d|--dry-run, Affiche les bundles sans exécuter les commits\n"
    printf "\n"
    printf "Description:\n"
    printf " Parcourt tous les dossiers dans le répertoire 'bundles/' du répertoire courant,\n"
    printf " exécute un commit avec génération automatique de message via DeepSeek, et push.\n"
    return 0
}

# Gestion des options
force=0
passtest=0
dry_run=0
message=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force|-f)
            force=1
            shift
        ;;
        --passtest|-p)
            passtest=1
            shift
        ;;
        --dry-run|-d)
            dry_run=1
            shift
        ;;
        --help|-h)
            show_usage
            exit 0
        ;;
        --)
            shift
        ;;
        -* )
            echo "Option inconnue: $1"
            show_usage
            exit 1
        ;;
        *)
            message="$1"
            shift
            break
        ;;
    esac
done

# Vérifier que le répertoire bundles existe
if [ ! -d "bundles" ]; then
    echo "Erreur: Le répertoire 'bundles/' n'existe pas dans le répertoire courant."
    exit 1
fi

# Récupérer la liste des dossiers dans bundles/
bundles=()
while IFS= read -r dir; do
    if [ -d "$dir" ]; then
        bundles+=("$dir")
    fi
done < <(find bundles -maxdepth 1 -type d ! -path bundles | sort)

if [ ${#bundles[@]} -eq 0 ]; then
    echo "Aucun dossier trouvé dans bundles/"
    exit 0
fi

echo "📦 $(( ${#bundles[@]} )) bundle(s) trouvé(s):"
for bundle in "${bundles[@]}"; do
    echo "  - $(basename "$bundle")"
done

if [ $dry_run -eq 1 ]; then
    echo "🔍 Mode dry-run - aucun commit ne sera exécuté"
    exit 0
fi

echo ""
echo "🚀 Démarrage du traitement des bundles..."
echo ""

# Fonction pour charger la configuration DeepSeek
load_deepseek_config() {
    # Charger .env local si présent
    if [ -f .env ]; then
        while IFS= read -r line; do
            if [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
                export "$line"
            fi
        done < .env
    fi

    if [ -f .env.local ]; then
        while IFS= read -r line; do
            if [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
                export "$line"
            fi
        done < .env.local
    fi

    # Charger depuis ~/debs ou ~/git/debs
    if [ -f "$HOME/debs/.env.local" ]; then
        while IFS= read -r line; do
            if [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
                export "$line"
            fi
        done < "$HOME/debs/.env.local"
    elif [ -f "$HOME/git/debs/.env.local" ]; then
        while IFS= read -r line; do
            if [[ $line =~ ^[A-Za-z_][A-Za-z0-9_]*= ]]; then
                export "$line"
            fi
        done < "$HOME/git/debs/.env.local"
    fi

    # Vérifier DEEPSEEK_MODEL
    if [ -z "$DEEPSEEK_MODEL" ]; then
        if [ -f "$HOME/.bashrc" ]; then
            source "$HOME/.bashrc" 2>/dev/null || true
        fi
        if [ -f "$HOME/.profile" ]; then
            source "$HOME/.profile" 2>/dev/null || true
        fi
        if [ -f "$HOME/.env" ]; then
            while IFS= read -r line; do
                if [[ $line =~ ^DEEPSEEK_MODEL= ]]; then
                    export "$line"
                fi
            done < "$HOME/.env" 2>/dev/null || true
        fi
        if [ -z "$DEEPSEEK_MODEL" ]; then
            export DEEPSEEK_MODEL="deepseek-v4-flash"
            echo "⚠️ DEEPSEEK_MODEL non configuré, utilisation du modèle par défaut: deepseek-v4-flash"
        fi
    fi

    # Vérifier DEEPSEEK_API_KEY
    if [ -z "$DEEPSEEK_API_KEY" ]; then
        if [ -f "$HOME/.bashrc" ]; then
            source "$HOME/.bashrc" 2>/dev/null || true
        fi
        if [ -f "$HOME/.profile" ]; then
            source "$HOME/.profile" 2>/dev/null || true
        fi
        if [ -f "$HOME/.env" ]; then
            while IFS= read -r line; do
                if [[ $line =~ ^DEEPSEEK_API_KEY= ]]; then
                    export "$line"
                fi
            done < "$HOME/.env" 2>/dev/null || true
        fi
        if [ -z "$DEEPSEEK_API_KEY" ] && [ -n "$(printenv DEEPSEEK_API_KEY)" ]; then
            export DEEPSEEK_API_KEY="$(printenv DEEPSEEK_API_KEY)"
        fi
    fi
}

# Fonction pour exécuter le commit sur un bundle
process_bundle() {
    local bundle_dir="$1"
    local bundle_name=$(basename "$bundle_dir")
    echo ""
    echo "=========================================="
    echo "📁 Traitement du bundle: $bundle_name"
    echo "=========================================="

    # Sauvegarder le répertoire courant
    local original_dir=$(pwd)

    # Aller dans le répertoire du bundle
    cd "$bundle_dir" || {
        echo "❌ Erreur: Impossible d'accéder à $bundle_dir"
        return 1
    }

    echo "📂 Répertoire: $(pwd)"

    # Vérifier si c'est un dépôt git
    if [ ! -d ".git" ]; then
        echo "⚠️  Pas de dépôt git dans $bundle_name, ignore"
        cd "$original_dir"
        return 0
    fi

    # Vérifier s'il y a des modifications
    if [[ ! $(git status --porcelain) ]] && [ $force -eq 0 ]; then
        echo "✅ Aucune modification dans $bundle_name"
        cd "$original_dir"
        return 0
    fi

    # Vérifier si tests existe
    local local_passtest=$passtest
    if [ ! -d "tests" ]; then
        local_passtest=1
    fi

    # Exécuter les tests si nécessaire
    if [ -f bin/phpunit ] && [ $local_passtest -eq 0 ]; then
        echo "🧪 Running tests pour $bundle_name..."
        local current_dir=$(basename "$(pwd)")
        docker exec -i "$current_dir" bin/phpunit 2>/dev/null || true
        if [ $? -ne 0 ]; then
            echo "❌ ERREUR DANS LES TESTS pour $bundle_name - ARRET"
            cd "$original_dir"
            return 1
        fi
    fi

    # Générer le message de commit
    local commit_message=""
    if [ -n "$message" ]; then
        commit_message="$message"
        echo "📝 Message fourni: $commit_message"
    else
        echo "🤖 Génération du message par DeepSeek..."
        commit_message=$(generate_commit_message)
        if [ -z "$commit_message" ]; then
            echo "❌ Échec de génération du message pour $bundle_name"
            cd "$original_dir"
            return 1
        fi
        echo "📝 Message généré: $commit_message"
    fi

    # Ajouter les fichiers et commit
    git add .
    echo "⬆️  Commit en cours..."
    git commit -m "$commit_message"

    # Pousser
    echo "🚀 Push en cours..."
    git push --all 2>/dev/null || {
        echo "⚠️  Push --all échoué, tentative push simple..."
        git push 2>/dev/null || {
            echo "⚠️  Push échoué, tentative push --force..."
            git push --force 2>/dev/null || {
                echo "❌ Push échoué pour $bundle_name"
                cd "$original_dir"
                return 1
            }
        }
    }
    git push --tags 2>/dev/null || true

    echo "✅ $bundle_name traité avec succès"

    # Retourner au répertoire d'origine
    cd "$original_dir"
    return 0
}

# Fonction pour générer le message de commit avec DeepSeek
generate_commit_message() {
    # Charger la configuration
    load_deepseek_config

    if [ -z "$DEEPSEEK_API_KEY" ]; then
        echo "❌ DeepSeek non configuré. Veuillez fournir un message manuel."
        return 1
    fi

    if [[ ! "$DEEPSEEK_API_KEY" =~ ^sk- ]]; then
        echo "❌ Erreur: La clé API ne semble pas être une clé DeepSeek valide."
        return 1
    fi

    # Générer le diff
    local diff=$(git diff --cached)
    if [ -z "$diff" ]; then
        diff=$(git diff)
    fi
    if [ -z "$diff" ]; then
        echo "⚠️  Aucune modification détectée pour ce bundle."
        return 1
    fi

    # Tronquer le diff si trop volumineux
    local max_diff=20000
    if [ ${#diff} -gt $max_diff ]; then
        echo "[AVERTISSEMENT] Diff tronqué à $max_diff caractères"
        diff="${diff:0:$max_diff}\n[...diff tronqué...]"
    fi

    # Préparer la requête
    local prompt="Donne un commit git au format {\"title\":\"...\",\"body\":\"...\"} pour ce diff (max 100 tokens). Réponds uniquement par un objet JSON, rien d'autre. Diff: $diff"

    local tmp_prompt=$(mktemp)
    echo -n "$prompt" > "$tmp_prompt"

    local tmp_json=$(mktemp)
    printf '{"model": "'"$DEEPSEEK_MODEL"'", "messages": [{"role": "user", "content": ' > "$tmp_json"
    jq -Rs . < "$tmp_prompt" >> "$tmp_json"
    printf '}]}' >> "$tmp_json"
    rm -f "$tmp_prompt"

    if [ ! -s "$tmp_json" ]; then
        echo "❌ Erreur lors de la préparation du prompt"
        rm -f "$tmp_json"
        return 1
    fi

    # Appel API
    local raw_response=$(curl -s -w "\nHTTP_CODE:%{http_code}" -X POST https://api.deepseek.com/v1/chat/completions \
        -H "Content-Type: application/json" \
        -H "Authorization: Bearer $DEEPSEEK_API_KEY" \
        --data-binary "@${tmp_json}")

    local http_code=$(echo "$raw_response" | tail -n1 | sed 's/HTTP_CODE://')
    raw_response=$(echo "$raw_response" | head -n -1)

    rm -f "$tmp_json"

    if [ "$http_code" != "200" ]; then
        echo "❌ Erreur HTTP $http_code lors de l'appel à DeepSeek"
        return 1
    fi

    # Extraire le message
    local content=$(echo "$raw_response" | jq -r '.choices[0].message.content')
    local clean_response=$(echo "$content" | tr -d '\n' | sed 's/```json//g; s/```//g')
    local json_commit=$(echo "$clean_response" | sed 's/.*{\(.*\)}.*/{\1}/')

    if ! echo "$json_commit" | grep -q '^{.*}$'; then
        echo "❌ Réponse DeepSeek invalide"
        return 1
    fi

    local title=$(echo "$json_commit" | jq -r '.title')
    local body=$(echo "$json_commit" | jq -r '.body')

    if [ -z "$title" ] || [ "$title" == "null" ]; then
        echo "❌ Titre de commit manquant"
        return 1
    fi

    if [ -n "$body" ] && [ "$body" != "null" ]; then
        printf "%s\n\n%s" "$title" "$body"
    else
        echo "$title"
    fi
}

# Fonction principale
main() {
    echo "🔧 Chargement de la configuration DeepSeek..."
    load_deepseek_config

    local total=${#bundles[@]}
    local current=0
    local failed=()

    for bundle in "${bundles[@]}"; do
        ((current++))
        echo ""
        echo "══════════════════════════════════════════════════════"
        echo "⏳ Progression: $current / $total"
        echo "══════════════════════════════════════════════════════"

        if ! process_bundle "$bundle"; then
            failed+=("$(basename "$bundle")")
        fi
    done

    # Résumé
    echo ""
    echo "══════════════════════════════════════════════════════"
    echo "📊 RÉSUMÉ FINAL"
    echo "══════════════════════════════════════════════════════"
    echo "✅ Traités: $(( total - ${#failed[@]} )) / $total"

    if [ ${#failed[@]} -gt 0 ]; then
        echo "❌ Échecs:"
        for f in "${failed[@]}"; do
            echo "  - $f"
        done
        exit 1
    else
        echo "🎉 Tous les bundles ont été traités avec succès !"
        exit 0
    fi
}

# Lancer le script
main
