#!/bin/bash

# Aide rapide
for arg in "$@"; do
    if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        echo "Detect and remove secrets from Git history using Gitleaks and BFG. Parameters: none."
        exit 0
    fi
done

cleanup() {
  rm -f gitleaks-report.json secrets-to-clean.txt bfg.jar
}

trap cleanup EXIT

echo "🔍 Détection des secrets avec Gitleaks..."

docker run --rm -v $(pwd):/repo zricethezav/gitleaks:latest detect \
  --source="/repo" \
  --report-format json \
  --report-path /repo/gitleaks-report.json

if [ -f gitleaks-report.json ] && [ -s gitleaks-report.json ]; then
  LEAK_COUNT=$(cat gitleaks-report.json | jq 'length')
  
  if [ "$LEAK_COUNT" -gt 0 ]; then
    echo "⚠️  $LEAK_COUNT secret(s) détecté(s), nettoyage en cours..."
    
    # Créer le fichier de remplacement pour BFG
    cat gitleaks-report.json | jq -r '.[].Secret' | sed 's/^/regex:/' | sed 's/$/===>***REMOVED***/' > secrets-to-clean.txt
    
    # Télécharger BFG si nécessaire
    if [ ! -f bfg.jar ]; then
      wget -q https://repo1.maven.org/maven2/com/madgag/bfg/1.14.0/bfg-1.14.0.jar -O bfg.jar
    fi
    
    # Nettoyer avec BFG
    java -jar bfg.jar --replace-text secrets-to-clean.txt .
    
    # Nettoyer les refs
    git reflog expire --expire=now --all
    git gc --prune=now --aggressive
    
    echo "✅ Historique nettoyé! $LEAK_COUNT secret(s) supprimé(s)."
  else
    echo "✅ Aucun secret détecté"
  fi
else
  echo "✅ Aucun secret détecté"
fi
