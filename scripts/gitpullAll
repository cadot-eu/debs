#!/bin/bash
# Couleurs pour l'affichage
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${YELLOW}🔍 Recherche de dépôts Git pour mise à jour...${NC}\n"

# Fonction pour faire un git pull dans un dépôt
pull_repo() {
    local dir="$1"

    # Vérifier si c'est un dépôt git
    if [ -d "$dir/.git" ]; then
        cd "$dir" || return

        echo -e "${BLUE}📂 Dépôt trouvé: ${dir}${NC}"

        # Récupérer la branche courante
        branch=$(git branch --show-current)
        if [ -z "$branch" ]; then
            echo -e "${RED}⚠️  Pas de branche courante (detached HEAD ?), ignoré${NC}"
            echo "----------------------------------------"
            cd - > /dev/null || return
            return
        fi
        echo -e "${YELLOW}Branche: ${branch}${NC}"

        # Informer seulement, sans bloquer le pull
        if ! git diff-index --quiet HEAD -- 2>/dev/null; then
            echo -e "${YELLOW}ℹ️  Modifications locales détectées (stashées puis réappliquées) :${NC}"
            git status --short
        fi

        # Exécuter git pull avec autostash
        echo -e "${YELLOW}🔄 Exécution de git pull --autostash...${NC}"
        if git pull --autostash; then
            echo -e "${GREEN}✅ git pull réussi${NC}\n"
        else
            echo -e "${RED}❌ Erreur lors du git pull${NC}\n"
        fi

        echo "----------------------------------------"
        cd - > /dev/null || return
    fi
}

# Exporter la fonction pour l'utiliser avec find
export -f pull_repo
export GREEN YELLOW RED BLUE NC

# Parcourir le répertoire courant et tous les sous-répertoires
find . -type d -name ".git" 2>/dev/null | while read -r gitdir; do
    repo_dir=$(dirname "$gitdir")
    pull_repo "$repo_dir"
done

echo -e "${GREEN}✨ Mise à jour terminée!${NC}"
