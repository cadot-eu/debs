#!/bin/bash

# Aide rapide
for arg in "$@"; do
    if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        echo "Download YouTube videos with subtitles (French preferred, English fallback). Parameters: <url> <filename-without-extension>"
        exit 0
    fi
done

# Si plus de 2 paramètres → URL probablement non entourée de guillemets
if [ "$#" -gt 2 ]; then
  echo "❌ Trop de paramètres détectés"
  echo
  echo "⚠️  L'URL DOIT être entre guillemets"
  echo "    (sinon les & sont interprétés par le shell)"
  echo
  echo "Usage : $0 \"<URL>\" <nom_fichier_sans_extension>"
  echo "Exemple :"
  echo "  $0 \"https://www.youtube.com/watch?v=XXX&list=YYY&index=5\" ma_video"
  exit 1
fi

# Nombre incorrect de paramètres
if [ "$#" -ne 2 ]; then
  echo "❌ Mauvaise utilisation"
  echo
  echo "Usage : $0 \"<URL>\" <nom_fichier_sans_extension>"
  exit 1
fi

URL="$1"
BASENAME="$2"

# Refuser extension dans le nom de fichier
if [[ "$BASENAME" == *.* ]]; then
  echo "❌ Ne pas donner d'extension pour le fichier destination"
  echo "   Exemple correct   : ma_video"
  echo "   Exemple incorrect : ma_video.mp4"
  exit 1
fi

echo "📥 Téléchargement avec sous-titres français..."

# Commande exacte avec français
yt-dlp --write-subs --sub-langs fr --embed-subs --no-playlist -o "${BASENAME}.%(ext)s" "$URL"

echo
echo "🔍 Vérification de la présence des sous-titres français..."

# Vérifier si un fichier .fr.srt existe
if ls "${BASENAME}"*.fr.* 2>/dev/null | grep -q .; then
  echo "✅ Sous-titres français trouvés et intégrés !"
else
  echo "⚠️  Aucun sous-titre français trouvé"
  echo "🗑️  Suppression du fichier téléchargé..."
  rm -f "${BASENAME}".*
  
  echo "📥 Nouveau téléchargement avec sous-titres anglais..."
  
  # Même commande exacte mais avec anglais
  yt-dlp --write-subs --sub-langs en --embed-subs --no-playlist -o "${BASENAME}.%(ext)s" "$URL"
  
  echo
  echo "🔍 Vérification de la présence des sous-titres anglais..."
  
  if ls "${BASENAME}"*.en.srt 2>/dev/null | grep -q .; then
    echo "✅ Sous-titres anglais trouvés et intégrés !"
  else
    echo "⚠️  Aucun sous-titre disponible"
    echo "✅ Vidéo téléchargée sans sous-titres"
  fi
fi

echo "✅ Terminé !"
